PORT=5000
NODE_ENV=development

# Database
# Hosted Postgres (Neon etc.) - when set, the DB_* MySQL settings below are ignored.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=3306
DB_NAME=savethedate_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis
REDIS_URL=redis://localhost:6379

# Email
# Preferred on hosts that block SMTP (e.g. Render free plan): Brevo HTTPS API.
# EMAIL_FROM must be a sender you verified in Brevo.
# BREVO_API_KEY=your_brevo_api_key
# EMAIL_FROM=you@example.com
# Otherwise SMTP (works locally):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=noreply@savethedate.com

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=

# Google Gemini API (used for AI theme generation in admin panel)
GEMINI_API_KEY=your_gemini_api_key

# Unsplash API (used to auto-fetch a preview photo for AI-generated themes)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Frontend URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174

# Public URL of this backend (used for one-click email links). On Render this
# falls back to the auto-provided RENDER_EXTERNAL_URL if left blank.
API_URL=http://localhost:5000

# Admin panel account - created on server start if it doesn't exist.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_RESET_PASSWORD=true   # one-off: overwrite an existing admin's password
